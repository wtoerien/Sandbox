# Azure AD App Registration credentials
# Register an app at https://portal.azure.com -> Azure Active Directory -> App registrations
# Required API permissions (Delegated):
#   Mail.Read, Mail.ReadWrite, Mail.Send, Calendars.ReadWrite

AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here

# Optional: redirect URI for auth code flow (default: uses device code flow)
# AZURE_REDIRECT_URI=http://localhost:8080/callback

# Token cache file path (default: .token_cache.json)
# TOKEN_CACHE_FILE=.token_cache.json
